# Ignore large ad-hoc data by default.
*.csv
*.json
*.jsonl
*.safetensors

# Track small reproducibility files.
!configs/*.json
!results/*.json
!examples/*.json
!examples/*.csv

# Track the final LoRA adapter used by the fine-tuned RAG demo.
!models/
